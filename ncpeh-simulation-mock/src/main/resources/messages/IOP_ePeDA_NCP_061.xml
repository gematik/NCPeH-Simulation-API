<env:Fault xmlns:env="http://www.w3.org/2003/05/soap-envelope"
  xmlns:xml="http://www.w3.org/XML/1998/namespace" xmlns:ehealth="urn:ehealth:v1">
  <env:Code>
    <env:Value>env:Sender</env:Value>
    <env:Subcode>
      <env:Value>ehealth:InvalidSecurityToken</env:Value>
    </env:Subcode>
  </env:Code>
  <env:Reason>
    <env:Text xml:lang="en">The country of origin in the request is inconsistent. Please contact
      your service provider or administrator.
    </env:Text>
  </env:Reason>
  <env:Detail>Country code received from the public TLS key= BE. Country code received from the
    public key of TRC Assurance= FR.
  </env:Detail>
</env:Fault>
